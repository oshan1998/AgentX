{
  "schemaVersion": "1",
  "name": "web_search",
  "description": "Search the web using Tavily and return top matches.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Search query."
      },
      "maxResults": {
        "type": "number",
        "description": "1–10; optional."
      }
    },
    "required": ["query"]
  },
  "steps": [
    {
      "type": "tool_call",
      "tool": "web_search",
      "input": {
        "query": "{{input.query}}",
        "maxResults": "{{input.maxResults}}"
      },
      "saveAs": "results"
    },
    {
      "type": "respond",
      "messageTemplate": "{{results}}"
    }
  ]
}
