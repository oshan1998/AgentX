{
  "schemaVersion": "1",
  "name": "read_email",
  "description": "Read a Gmail email by message ID.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Gmail message id."
      }
    },
    "required": ["id"]
  },
  "steps": [
    {
      "type": "tool_call",
      "tool": "read_email",
      "input": {
        "id": "{{input.id}}"
      },
      "saveAs": "email"
    },
    {
      "type": "respond",
      "messageTemplate": "{{email}}"
    }
  ]
}
