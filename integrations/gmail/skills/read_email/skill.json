{
  "schemaVersion": "1",
  "name": "read_email",
  "description": "Read a Gmail email by message ID.",
  "steps": [
    {
      "type": "tool_call",
      "tool": "read_email",
      "input": {
        "id": "{{input.id}}"
      },
      "saveAs": "email"
    },
    {
      "type": "respond",
      "messageTemplate": "{{email}}"
    }
  ]
}
