{
  "schemaVersion": "1",
  "name": "search_emails",
  "description": "Search Gmail emails by query string.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Gmail search query."
      },
      "maxResults": {
        "type": "number",
        "description": "Optional cap; default 5."
      }
    },
    "required": ["query"]
  },
  "steps": [
    {
      "type": "tool_call",
      "tool": "search_emails",
      "input": {
        "query": "{{input.query}}",
        "maxResults": "{{input.maxResults}}"
      },
      "saveAs": "emails"
    },
    {
      "type": "respond",
      "messageTemplate": "{{emails}}"
    }
  ]
}
