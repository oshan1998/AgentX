{
  "schemaVersion": "1",
  "kind": "agentic",
  "name": "prepare_images_for_design",
  "description": "Download image URLs into the workspace, read metadata, and normalize dimensions for use in design skills.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "imageUrls": {
        "type": "array",
        "items": { "type": "string" },
        "description": "HTTPS image URLs to download."
      },
      "outputDir": {
        "type": "string",
        "description": "Workspace directory for outputs (e.g. assets/). Default assets/."
      },
      "maxWidth": {
        "type": "number",
        "description": "Max width when normalizing. Default 1920."
      },
      "maxHeight": {
        "type": "number",
        "description": "Max height when normalizing. Default 1920."
      }
    },
    "required": ["imageUrls"]
  },
  "toolNames": ["download_image", "read_image_metadata", "crop_and_resize"],
  "maxIterations": 16,
  "deadlineMs": 180000
}
