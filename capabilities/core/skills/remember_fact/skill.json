{
  "schemaVersion": "1",
  "kind": "workflow",
  "name": "remember_fact",
  "description": "Persist a meaningful long-term memory entry.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "description": "Memory category: user_preference, behavior_rule, or fact."
      },
      "content": {
        "type": "string",
        "description": "Text to store."
      }
    },
    "required": ["type", "content"]
  },
  "steps": [
    {
      "type": "memory_write",
      "memoryTypeTemplate": "{{input.type}}",
      "contentTemplate": "{{input.content}}"
    },
    {
      "type": "respond",
      "messageTemplate": "Saved memory: {{input.type}}"
    }
  ]
}
