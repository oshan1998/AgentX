{
  "schemaVersion": "1",
  "name": "read_pdf",
  "description": "Read and extract text from a PDF file.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "PDF path under workspace/."
      }
    },
    "required": ["path"]
  },
  "steps": [
    {
      "type": "tool_call",
      "tool": "read_pdf",
      "input": {
        "path": "{{input.path}}"
      },
      "saveAs": "pdfData"
    },
    {
      "type": "respond",
      "messageTemplate": "PDF Content ({{pdfData.numpages}} pages):\n\n{{pdfData.text}}"
    }
  ]
}
