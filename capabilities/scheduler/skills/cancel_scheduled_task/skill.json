{
  "schemaVersion": "1",
  "name": "cancel_scheduled_task",
  "description": "Cancel a scheduled cron task by ID.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Cron job id to delete."
      }
    },
    "required": ["id"]
  },
  "steps": [
    {
      "type": "tool_call",
      "tool": "delete_cron_job",
      "input": {
        "id": "{{input.id}}"
      },
      "saveAs": "result"
    },
    {
      "type": "respond",
      "messageTemplate": "Cancel result: {{result}}"
    }
  ]
}
