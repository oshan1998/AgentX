{
  "schemaVersion": "1",
  "name": "cancel_scheduled_task",
  "description": "Cancel a scheduled cron task by ID.",
  "steps": [
    {
      "type": "tool_call",
      "tool": "delete_cron_job",
      "input": {
        "id": "{{input.id}}"
      },
      "saveAs": "result"
    },
    {
      "type": "respond",
      "messageTemplate": "Cancel result: {{result}}"
    }
  ]
}
