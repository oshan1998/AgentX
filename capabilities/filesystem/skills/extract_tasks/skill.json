{
  "schemaVersion": "1",
  "name": "extract_tasks",
  "description": "Read a document from the workspace and extract its explicit action items as a list.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Source document path."
      }
    },
    "required": ["path"]
  },
  "steps": [
    {
      "type": "tool_call",
      "tool": "read_file",
      "input": {
        "path": "{{input.path}}"
      },
      "saveAs": "documentContent"
    },
    {
      "type": "llm",
      "promptTemplate": "Extract actionable tasks from this content. Return one task per line.\n\n{{documentContent}}",
      "saveAs": "tasks"
    },
    {
      "type": "respond",
      "messageTemplate": "{{tasks}}"
    }
  ]
}
