{
  "schemaVersion": "1",
  "name": "summarize_document",
  "description": "Read a document from the workspace and return a concise bullet-point summary using an LLM.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Document path to read."
      }
    },
    "required": ["path"]
  },
  "steps": [
    {
      "type": "tool_call",
      "tool": "read_file",
      "input": {
        "path": "{{input.path}}"
      },
      "saveAs": "documentContent"
    },
    {
      "type": "llm",
      "promptTemplate": "Summarize this content in 5 bullets:\n\n{{documentContent}}",
      "saveAs": "summary"
    },
    {
      "type": "respond",
      "messageTemplate": "{{summary}}"
    }
  ]
}
