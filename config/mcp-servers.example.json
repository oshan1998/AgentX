{
  "mcpServers": {
    "filesystem": {
      "transport": "stdio",
      "disabled": true,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${PWD}/workspace"],
      "namePrefix": "fs"
    },
    "github": {
      "transport": "stdio",
      "disabled": true,
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" },
      "namePrefix": "github"
    },
    "design": {
      "transport": "http",
      "disabled": true,
      "url": "http://localhost:3101/mcp",
      "namePrefix": "design",
      "toolTimeoutMs": 180000
    }
  }
}
