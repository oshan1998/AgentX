{
  "mcpServers": {
    "filesystem": {
      "transport": "stdio",
      "disabled": true,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${PWD}/workspace"],
      "namePrefix": "fs"
    },
    "github": {
      "transport": "stdio",
      "disabled": true,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" },
      "namePrefix": "github",
      "toolTimeoutMs": 120000
    },
    "design": {
      "transport": "stdio",
      "disabled": true,
      "command": "npx",
      "args": ["tsx", "mcp/design/index.ts"],
      "namePrefix": "",
      "toolTimeoutMs": 180000
    },
    "web": {
      "transport": "stdio",
      "disabled": true,
      "command": "npx",
      "args": ["tsx", "mcp/web/index.ts"],
      "namePrefix": ""
    },
    "gmail": {
      "transport": "stdio",
      "disabled": true,
      "command": "npx",
      "args": ["tsx", "mcp/gmail/index.ts"],
      "namePrefix": ""
    }
  }
}
