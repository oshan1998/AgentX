{
  "mcpServers": {
    "github": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "namePrefix": "github",
      "toolTimeoutMs": 120000
    },
    "design": {
      "transport": "stdio",
      "command": "npx",
      "args": ["tsx", "mcp/design/index.ts"],
      "namePrefix": "",
      "toolTimeoutMs": 180000
    }
  }
}
