# ── Recommended: Vertex AI (Gemini + Imagen) ─────────────────
LLM_PROVIDER=gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# gemini-3.5-flash requires global (or us/eu), e.g. GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

VISION_PROVIDER=gemini
IMAGE_GEN_PROVIDER=vertex
IMAGEN_MODEL=imagen-4.0-generate-001

# Optional: background removal tuning (defaults: 0.02 dilation, 0.5 mask blur; set to 0 to disable)
# IMAGEN_SEGMENTATION_MASK_DILATION=0.02
# IMAGEN_SEGMENTATION_MASK_BLUR=0.5

# ── App ──────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
PORT=3000

# ── Optional integrations ────────────────────────────────────
TAVILY_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
UNSPLASH_ACCESS_KEY=

# GitHub MCP (external tools registered as github.* — e.g. github.search_repositories)
GITHUB_TOKEN=

# Jira MCP — optional headless auth for the "jira-token" HTTP server in mcp-servers.example.json
# (OAuth via mcp-remote on first startup is the default; admin must enable API tokens in Atlassian)
# ATLASSIAN_MCP_AUTH=Bearer <scoped-atlassian-mcp-token>

# Figma MCP (remote) — OAuth client name on Figma's allowlist (default: Claude Code).
# Run `npm run mcp:figma:auth` once before first use; tokens live in ~/.mcp-auth.
# FIGMA_MCP_CLIENT_NAME=Claude Code

# ── Alternative LLM providers ─────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=ollama
# OLLAMA_API_BASE=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:1.7b
