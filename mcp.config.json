      "command": "node",
      "args": ["dist/mcp-servers/design/index.js"]
    },
    "filesystem": {
      "type": "stdio",
      "internal": true,
      "command": "node",
      "args": ["dist/mcp-servers/filesystem/index.js"]
    },
    "web-search": {
      "type": "stdio",
      "internal": true,
      "command": "node",
      "args": ["dist/mcp-servers/web-search/index.js"]
    },
    "miro": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.miro.com/"]
    }
  }
